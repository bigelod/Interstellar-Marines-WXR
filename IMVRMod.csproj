<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The default Configuration is forced to Release in Directory.Build.props,
         which is imported early enough to beat the SDK's own Debug default. -->
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>IMVRMod</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>3</LangVersion>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- The SDK globs **/*.cs, which sweeps up anything dropped under Release/ -
         decompiled game source from dnSpy, packaged build output, test captures.
         That source is reference material, is gitignored, and must never be
         compiled into the mod: it does not build (C# 6 syntax), and compiling the
         game's own code into a redistributable is exactly what the licensing rule
         in Docs/general_wxr/CLAUDE.md forbids. -->
    <Compile Remove="Release/**/*.cs" />
    <Compile Remove="Docs/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>Libs/BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>Libs/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>Libs/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>Libs/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
	<Reference Include="uLink">
	  <HintPath>Libs/uLink.dll</HintPath>
	</Reference>
  </ItemGroup>
</Project>
